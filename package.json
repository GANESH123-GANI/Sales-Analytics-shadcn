{
  "name": "sales-analytics-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node backend/src/server.js",
    "web": "cd mobile && npx expo start --web",
    "build": "node scripts/build.js",
    "serve": "node backend/src/server.js",
    "backend": "cd backend && npm start",
    "mobile": "cd mobile && npx expo start",
    "start:backend": "cd backend && npm start",
    "start:web": "cd mobile && npx expo start --web",
    "start:mobile": "cd mobile && npx expo start",
    "db:setup": "cd backend && npm run db:setup",
    "db:neon": "cd backend && npm run db:neon"
  },
  "dependencies": {
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
